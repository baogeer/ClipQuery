# =============================================================================
# ClipQuery 配置模板（可提交到仓库）
#
# 首次部署：
#   cp .env.example .env
#   chmod 600 .env          # Linux 下建议
#   vim .env                # 把下面标 *** 的值换成真的
#
# 所有变量前缀 CLIPQUERY_，由 pydantic-settings 自动加载（见 clipquery/config.py）。
# HF_* 和 HF_TOKEN 不带前缀，让 huggingface_hub / transformers 自动拾取。
# =============================================================================


# ============================ 路径配置 ============================
# 不显式设置时，项目路径自动取仓库根目录。Linux 部署建议显式指定绝对路径，
# 避免服务以不同工作目录启动时产物路径漂移。
# CLIPQUERY_PROJECT_ROOT=/srv/clipquery        # 项目根；其他路径默认基于它
# CLIPQUERY_NEWS_DIR=/srv/clipquery/news       # 爬虫产物的临时工作区
# CLIPQUERY_DATA_DIR=/srv/clipquery/data       # 缩略图 / 切片 / 模型缓存的工作区


# ============================ 模型与抽帧 ============================
# CLIP 模型名。sentence-transformers 风格，等价于 sentence-transformers/clip-ViT-B-32。
CLIPQUERY_CLIP_MODEL_NAME=clip-ViT-B-32

# CLIP 输出向量维度。clip-ViT-B-32 是 512；换模型（如 clip-ViT-L-14=768）必须同步改。
# 改完要删掉重建 clipquery_frames 索引。
CLIPQUERY_EMBEDDING_DIM=512

# PyTorch 设备：cpu 或 cuda。cuda 要先 pip 装对应 CUDA 版的 torch。
CLIPQUERY_DEVICE=cpu

# 抽帧频率（帧/秒）。1.0 表示每秒取 1 帧。提高抓更细镜头变化，但索引膨胀、入库变慢。
CLIPQUERY_FRAME_SAMPLE_FPS=1.0

# 单帧图像长边缩放到多少像素。CLIP ViT-B/32 内部是 224×224，384 够用。
CLIPQUERY_FRAME_MAX_SIDE=384

# CLIP 编码批大小。CPU 跑 32 舒服；GPU 可调到 64/128。
CLIPQUERY_BATCH_SIZE=32


# ============================ 视频切片 ============================
# 单个片段的目标最大长度（秒）。场景比这长会被二次等长拆分，
# 也是场景检测失败时的等长兜底窗口。
CLIPQUERY_CLIP_TARGET_SECONDS=6.0

# 片段最小长度（秒）。比这短的场景会被合并到前一个片段，避免产生碎片。
CLIPQUERY_CLIP_MIN_SECONDS=2.0

# PySceneDetect 的 ContentDetector 阈值。越小越敏感，切出的场景越多。
# 27 是 PySceneDetect 官方推荐默认值。
CLIPQUERY_SCENE_DETECT_THRESHOLD=27.0


# ============================ OpenSearch ============================
# 托管域名。AWS OpenSearch VPC endpoint 或 public endpoint。
CLIPQUERY_OPENSEARCH_HOST=***.es.amazonaws.com

# HTTPS 端口 443；http 改 9200。
CLIPQUERY_OPENSEARCH_PORT=443

# 基本认证用户。
CLIPQUERY_OPENSEARCH_USERNAME=admin

# 基本认证密码。**必须覆盖**。
CLIPQUERY_OPENSEARCH_PASSWORD=***

# 是否走 HTTPS。AWS 托管域默认 https。
CLIPQUERY_OPENSEARCH_USE_SSL=true

# 是否校验 HTTPS 证书。AWS 托管域有正规证书；自签环境再关。
CLIPQUERY_OPENSEARCH_VERIFY_CERTS=true

# 三个索引名。改名后老索引不会自动迁移，需手动 reindex。
# 帧向量 + 帧元数据（KNN 用）
CLIPQUERY_OPENSEARCH_INDEX=clipquery_frames
# 文章元数据（info.json 副本）
CLIPQUERY_OPENSEARCH_ARTICLE_INDEX=clipquery_articles
# 可播放片段 + COS URL
CLIPQUERY_OPENSEARCH_CLIP_INDEX=clipquery_clips
# 台词级 KNN（每条 SRT cue 一个文档，带 start_time/end_time）
CLIPQUERY_OPENSEARCH_SUBTITLE_INDEX=clipquery_subtitles

# 台词索引开关
# true：ingest_video 过程中解析 SRT → CLIP 文本编码 → 写 clipquery_subtitles
# false：不写台词索引（/search_subtitle 会返回空）
CLIPQUERY_INDEX_SUBTITLES=true
# 过短的 cue 跳过（秒 / 字符数），过滤语气词 / 错切噪声
CLIPQUERY_SUBTITLE_MIN_DURATION=0.3
CLIPQUERY_SUBTITLE_MIN_TEXT_LEN=2

# _bulk 批量写入 chunk 大小。越大写越快，但单次请求体越大。
CLIPQUERY_OPENSEARCH_BULK_SIZE=128

# HNSW 召回精度。越高越准越慢，128 是常用平衡点。
CLIPQUERY_OPENSEARCH_KNN_EF_SEARCH=128

# KNN 引擎：OpenSearch 3.0+ 必须用 faiss 或 lucene（nmslib 已弃用）。
# faiss 是 AWS 推荐，性能最好；lucene 不依赖外部库但稍慢。
CLIPQUERY_OPENSEARCH_KNN_ENGINE=faiss

# 向量距离空间。向量已 L2 归一化，innerproduct 等价余弦且更快。
# 其他选项：cosinesimil / l2 / l1。
CLIPQUERY_OPENSEARCH_KNN_SPACE_TYPE=innerproduct

# ============================ 任务执行参数 ============================
# 服务进程**不读取**以下字段；只有本地脚本会用。
#   - worker_enabled / scheduler_cgtn_interval_seconds / scheduler_consume_interval_seconds
#     服务 / 本地开发都可忽略，保留以免 .env 老文件报错。
#   - scheduler_task_heartbeat / scheduler_task_ttl
#     scripts/consume_one.py → executor 真会读：锁 TTL 和 PEXPIRE 心跳。
CLIPQUERY_WORKER_ENABLED=false
CLIPQUERY_SCHEDULER_CGTN_INTERVAL_SECONDS=3600
CLIPQUERY_SCHEDULER_CONSUME_INTERVAL_SECONDS=10
CLIPQUERY_SCHEDULER_TASK_HEARTBEAT=60
CLIPQUERY_SCHEDULER_TASK_TTL=1800


# ============================ Redis（任务队列 + 分布式锁，脚本层使用） ============================
# 用于：
#   1) 本地入队脚本 LPUSH 到 ClipQuery:ingest:queue
#   2) 本地消费脚本 BRPOP + 分布式锁 ClipQuery:lock:<task_id>
# **必须覆盖 host / password**。ElastiCache 等托管 Redis 走内网域名。
CLIPQUERY_REDIS_HOST=***.cache.amazonaws.com
CLIPQUERY_REDIS_PORT=6379
CLIPQUERY_REDIS_DB=0
CLIPQUERY_REDIS_USERNAME=
CLIPQUERY_REDIS_PASSWORD=***
CLIPQUERY_REDIS_SSL=true

# Redis key 命名空间（大小写敏感，与 COS 前缀对齐）。
CLIPQUERY_PROJECT_NAME=ClipQuery
# 保留字段：早期依赖留下，当前代码不读取。
CLIPQUERY_THREAD_POOL_SIZE=32

# 队列与元数据（通常不改）
CLIPQUERY_REDIS_INGEST_QUEUE_KEY=ClipQuery:ingest:queue
CLIPQUERY_REDIS_TASK_META_PREFIX=ClipQuery:task:
CLIPQUERY_REDIS_TASK_META_TTL=86400
CLIPQUERY_REDIS_BRPOP_TIMEOUT=5


# ============================ 腾讯云 COS ============================
# 从腾讯云 CAM 控制台申请，需要有对应 bucket 的 PutObject 权限。**必须覆盖**。
CLIPQUERY_COS_SECRET_ID=***
CLIPQUERY_COS_SECRET_KEY=***

# Bucket 所在地域。bucket 名字尾部的数字是 AppID，不代表 region。
CLIPQUERY_COS_REGION=ap-beijing

# Bucket 名称（带 AppID 后缀的完整名字，形如 <bucketname>-<appid>）。
CLIPQUERY_COS_BUCKET=***-1234567890

# 对象 key 的统一前缀。产物挂在 ClipQuery/<article_id>/... 下。
CLIPQUERY_COS_PREFIX=ClipQuery

# 访问协议。建议 https。
CLIPQUERY_COS_SCHEME=https


# ============================ Hugging Face（可选） ============================
# HF access token。公开模型（如 clip-ViT-B-32）**不填也能下载**，以下场景才需要：
#   - 用私有 / gated 模型（gated 需要先在 HF 页面点同意协议）
#   - 匿名下载被限流
# 到 https://huggingface.co/settings/tokens 申请 read 权限。
# HF_TOKEN=hf_***

# HF 镜像站。国内访问 huggingface.co 慢/被墙时用。
# 代码里已经默认 https://hf-mirror.com，这里可以覆盖或留空回官方。
# HF_ENDPOINT=https://hf-mirror.com

# HF 缓存目录。相对路径按**项目根**解析（data/hf_cache 实际落在
# <project_root>/data/hf_cache），和项目产物在一起便于迁移。
# 代码默认已经是 data/hf_cache，这里可覆盖。
# HF_HOME=data/hf_cache


# ============================ MCP ============================
# MCP (Streamable-HTTP) 端点自动挂载在主 FastAPI 的 /mcp 下，
# 和 REST 共享同一端口，无需额外配置。
# 客户端（Claude Desktop / Cursor / MCP Inspector）填 http://<host>:<port>/mcp 即可。
# 工具清单见 docs/接口文档.md §9（排除 /search，因为它要上传图片二进制）。
